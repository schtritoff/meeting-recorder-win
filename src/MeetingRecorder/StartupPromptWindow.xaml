<Window x:Class="MeetingRecorder.StartupPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Recorder for Windows" Icon="pack://application:,,,/MeetingRecorder;component/Assets/MeetingRecorder.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
    <CheckBox x:Name="OptionCheckBox" Margin="0,14,0,0" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="PrimaryButton" MinWidth="100" Margin="0,0,8,0" IsDefault="True" Click="OnPrimaryClick"/>
      <Button x:Name="SecondaryButton" MinWidth="100" IsCancel="True" Click="OnSecondaryClick"/>
    </StackPanel>
  </StackPanel>
</Window>
