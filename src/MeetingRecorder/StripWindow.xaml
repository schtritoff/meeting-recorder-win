<Window x:Class="MeetingRecorder.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetingRecorder"
        Title="{local:Loc RecordingControls}" Icon="pack://application:,,,/MeetingRecorder;component/Assets/MeetingRecorder.ico" Width="320" Height="40" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Background="#202020" Foreground="White"
        MouseLeftButtonDown="DragStrip" PreviewKeyDown="OnKeyDown">
    <Grid Margin="10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="78"/><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#x25CF;" Foreground="#ff5a4d" VerticalAlignment="Center"/>
        <TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00:00" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
            <ProgressBar x:Name="MicMeter" Maximum="1" Height="3" Foreground="#6ccb5f" Margin="0,0,0,3" AutomationProperties.Name="{local:Loc Microphone}"/>
            <ProgressBar x:Name="SystemMeter" Maximum="1" Height="3" Foreground="#6ccb5f" AutomationProperties.Name="{local:Loc SystemAudio}"/>
        </StackPanel>
        <Button x:Name="PauseButton" Grid.Column="3" Content="&#x23F8;" Click="PauseClick" ToolTip="{local:Loc Pause}" AutomationProperties.Name="{local:Loc Pause}" Padding="0" Margin="2,6"/>
        <Button Grid.Column="4" Content="&#x25A0;" Click="StopClick" ToolTip="{local:Loc Stop}" AutomationProperties.Name="{local:Loc Stop}" Background="#c42b1c" Foreground="White" Padding="0" Margin="2,6"/>
        <Button Grid.Column="5" Content="&#x2199;" Click="RestoreClick" ToolTip="{local:Loc FullWindow}" AutomationProperties.Name="{local:Loc FullWindow}" Padding="0" Margin="2,6"/>
    </Grid>
</Window>
