<Window x:Class="MeetingRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetingRecorder"
        Title="Meeting Recorder for Windows" Icon="pack://application:,,,/MeetingRecorder;component/Assets/MeetingRecorder.ico" Width="420" Height="650" MinWidth="380" MinHeight="450"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed" PreviewKeyDown="OnKeyDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Button label with an optional icon glyph (Segoe Fluent Icons code point in Tag). -->
        <DataTemplate x:Key="IconLabel">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding}" TextAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Null}">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="ContentTemplate" Value="{StaticResource IconLabel}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <!-- PrimaryButton (the one call-to-action per screen) is created in code: it builds on the Fluent accent style. -->
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" Width="*"/>
            <ColumnDefinition x:Name="NotesColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <StackPanel x:Name="DownloadPanel" Visibility="Collapsed" Margin="0,0,0,20">
                <TextBlock Text="{local:Loc DownloadHeading}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{local:Loc DownloadDescription}" Margin="0,6"/>
                <ProgressBar x:Name="DownloadBar" Maximum="1" Height="4"/>
                <TextBlock x:Name="DownloadText" Margin="0,6"/>
                <Button x:Name="DownloadButton" Content="{local:Loc Cancel}" Click="DownloadClick"/>
            </StackPanel>
            <StackPanel x:Name="RecoveryPanel"/>
            <StackPanel x:Name="RecordPanel">
                <TextBlock Text="{local:Loc MeetingTitle}" Margin="0,0,0,4"/>
                <TextBox x:Name="TitleBox" ToolTip="{local:Loc TitleExample}" AutomationProperties.Name="{local:Loc MeetingTitle}" TextChanged="TitleChanged"/>
                <TextBlock Text="{local:Loc Microphone}" Margin="0,14,0,4"/>
                <ProgressBar x:Name="MicMeter" Maximum="1" Height="6" Foreground="#0f7b0f" AutomationProperties.Name="{local:Loc Microphone}"/>
                <TextBlock x:Name="MicWarning" Text="{local:Loc NoMicrophone}" FontSize="12"/>
                <TextBlock Text="{local:Loc SystemAudio}" Margin="0,10,0,4"/>
                <ProgressBar x:Name="SystemMeter" Maximum="1" Height="6" Foreground="#0f7b0f" AutomationProperties.Name="{local:Loc SystemAudio}"/>
                <TextBlock x:Name="SystemWarning" Text="{local:Loc NoOutputDevice}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18">
                    <TextBlock x:Name="RecordDot" Text="&#x25CF;" Foreground="#c42b1c" FontSize="24" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="40" FontWeight="Light" TextWrapping="NoWrap"/>
                </StackPanel>
                <Button x:Name="StartButton" Style="{DynamicResource PrimaryButton}" Tag="&#xE720;" Content="{local:Loc StartRecording}" Click="StartClick"/>
                <Button x:Name="ContinueButton" Content="{local:Loc ContinuePrevious}" AutomationProperties.Name="{local:Loc ContinuePrevious}" Click="ContinueClick" Margin="0,8,0,0"/>
                <Grid x:Name="RecordingButtons" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <Button x:Name="PauseButton" Tag="&#xE769;" Content="{local:Loc Pause}" Click="PauseClick" Margin="0,0,8,0" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Tag="&#xE71A;" Content="{local:Loc Stop}" Click="StopClick" Background="#c42b1c" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="2" Content="&#x2197;" Click="CompactClick" ToolTip="{local:Loc CompactView}" AutomationProperties.Name="{local:Loc CompactView}"/>
                </Grid>
                <TextBlock x:Name="StartedText" FontSize="12" Margin="0,12,0,0"/>
            </StackPanel>
            <StackPanel x:Name="ProcessingPanel" Visibility="Collapsed">
                <TextBlock x:Name="ProcessingTitle" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="FinishedText" Margin="0,12,0,8"/>
                <TextBlock x:Name="MixingText" Text="{local:Loc Mixing}" Margin="0,4"/>
                <TextBlock x:Name="TranscribingText" Text="{local:Loc Transcribing}" Margin="0,4"/>
                <TextBlock x:Name="SavingText" Text="{local:Loc Saving}" Margin="0,4"/>
                <ProgressBar x:Name="ProcessingBar" Maximum="1" Height="4" Margin="0,12"/>
                <TextBlock x:Name="RemainingText" Margin="0,0,0,12"/>
            </StackPanel>
            <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                <TextBlock Text="{local:Loc TranscriptReady}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="OutputText" Margin="0,14"/>
                <TextBlock x:Name="ContinuationNotice" Margin="0,0,0,12" Visibility="Collapsed"/>
                <TextBlock x:Name="SeriesRecordNotice" Margin="0,0,0,12" Visibility="Collapsed" TextWrapping="Wrap"/>
                <Button Style="{DynamicResource PrimaryButton}" Tag="&#xE8A5;" Content="{local:Loc OpenTranscript}" Click="OpenTranscriptClick" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Tag="&#xE838;" Content="{local:Loc OpenFolder}" Click="OpenFolderClick" Margin="0,0,4,0" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Tag="&#xE720;" Content="{local:Loc NewRecording}" Click="NewClick" Margin="4,0,0,0" HorizontalAlignment="Stretch"/>
                </Grid>
                <Button x:Name="ContinueInOpenCodeButton" Content="{local:Loc ContinueInOpenCode}" Click="ContinueInOpenCodeClick" IsEnabled="False" Visibility="Collapsed"
                        Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="ContinueInOpenCodeStatus" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,12">
                <TextBlock x:Name="ErrorText"/>
                <Button x:Name="RetryButton" Style="{DynamicResource PrimaryButton}" Tag="&#xE72C;" Content="{local:Loc Retry}" Click="RetryClick" Margin="0,8,0,0"/>
                <Button Tag="&#xE720;" Content="{local:Loc NewRecording}" Click="NewClick" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,6">
                <TextBlock FontSize="12" VerticalAlignment="Center">
                    <Hyperlink Click="OpenMeetingsClick"><Run Text="{local:Loc OpenMeetings}"/></Hyperlink>
                </TextBlock>
                <ToggleButton x:Name="NotesButton" Content="{local:Loc Notes}" ToolTip="{local:Loc Notes}"
                              AutomationProperties.Name="{local:Loc Notes}" Margin="12,0,0,0" Padding="8,4"/>
            </StackPanel>
            <TextBlock Text="{local:Loc Attribution}" FontSize="11" Opacity="0.7"/>
        </StackPanel>
        </ScrollViewer>
        <Border x:Name="NotesPane" Grid.Column="1" Visibility="Collapsed"
                BorderBrush="#22000000" BorderThickness="1,0,0,0" Background="#08000000">
            <!-- Bounded rows: the star row gives the scroll viewer a finite height. -->
            <Grid Margin="12,20,12,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc NotesHeading}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="{local:Loc NotesHint}" FontSize="12" Opacity="0.7" Margin="0,4"/>
                <TextBlock Grid.Row="2" x:Name="NotesWarning" FontSize="12" Foreground="#c42b1c" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6"/>
                <ScrollViewer Grid.Row="3" x:Name="NotesRowsScroll" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                              PreviewMouseWheel="NotesWheel">
                    <StackPanel x:Name="NotesRows"/>
                </ScrollViewer>
                <TextBox Grid.Row="3" x:Name="NotesSavedText" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
